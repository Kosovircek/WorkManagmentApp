<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Osnovna tema (Compose nariše vse ostalo). -->
    <style name="Theme.SluzbaTaski" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Prosojna tema za okno hitrega vnosa (izgleda kot dialog nad domačim zaslonom). -->
    <style name="Theme.SluzbaTaski.QuickAdd" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
